@model InstructorInformationsSystem.Models.Instructor
@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="auth-container" style="max-width: 600px;">
    <h2 class="text-danger">Delete Instructor</h2>
    <p class="text-center text-muted">Are you sure you want to delete this instructor?</p>

    <div class="card p-3 mb-3">
        <dl class="row mb-0">
            <dt class="col-sm-4">Instructor ID:</dt>
            <dd class="col-sm-8">@Model.InstructorID</dd>

            <dt class="col-sm-4">Full Name:</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Designation:</dt>
            <dd class="col-sm-8">@Model.Designation</dd>

            <dt class="col-sm-4">E-mail Address:</dt>
            <dd class="col-sm-8">@Model.EmailAddress</dd>
        </dl>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.InstructorID" />
        <button type="submit" class="btn btn-danger w-100 mb-2">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary w-100">Cancel</a>
    </form>
</div>