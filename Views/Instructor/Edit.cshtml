@model InstructorInformationsSystem.Models.Instructor
@{
    ViewData["Title"] = "Edit Instructor";
}

<div class="auth-container" style="max-width: 600px;">
    <h2>Edit Instructor</h2>

    <form asp-action="Edit" method="post">
        <div class="form-group mb-3">
            <label asp-for="InstructorID">Instructor ID</label>
            <input asp-for="InstructorID" class="form-control" readonly />
        </div>

        <div class="row">
            <div class="col-md-6 form-group mb-3">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class="col-md-3 form-group mb-3">
                <label asp-for="Age">Age</label>
                <input asp-for="Age" type="number" class="form-control" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>
            <div class="col-md-3 form-group mb-3">
                <label asp-for="Gender">Gender</label>
                <select asp-for="Gender" class="form-control">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Address">Address</label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 form-group mb-3">
                <label asp-for="Designation">Designation</label>
                <input asp-for="Designation" class="form-control" />
                <span asp-validation-for="Designation" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group mb-3">
                <label asp-for="ContactNumber">Contact Number</label>
                <input asp-for="ContactNumber" class="form-control" />
                <span asp-validation-for="ContactNumber" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 form-group mb-3">
                <label asp-for="Majorship">Majorship</label>
                <input asp-for="Majorship" class="form-control" />
                <span asp-validation-for="Majorship" class="text-danger"></span>
            </div>
            <div class="col-md-6 form-group mb-3">
                <label asp-for="BachelorDegree">Bachelor Degree</label>
                <input asp-for="BachelorDegree" class="form-control" />
                <span asp-validation-for="BachelorDegree" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="EmailAddress">E-mail Address</label>
            <input asp-for="EmailAddress" class="form-control" />
            <span asp-validation-for="EmailAddress" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-warning w-100 mt-2">Update Instructor</button>
        <a asp-action="Index" class="btn btn-secondary w-100 mt-2">Cancel</a>
    </form>
</div>