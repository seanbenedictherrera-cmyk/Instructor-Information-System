@model IEnumerable<InstructorInformationsSystem.Models.Instructor>
@{
    ViewData["Title"] = "Instructor Dashboard";

    // Calculate quick metrics from the existing model
    var totalInstructors = Model.Count();
    var uniqueMajorships = Model.Select(i => i.Majorship).Where(m => !string.IsNullOrEmpty(m)).Distinct().Count();
    var uniqueDesignations = Model.Select(i => i.Designation).Where(d => !string.IsNullOrEmpty(d)).Distinct().Count();
}

<!-- Header & Action Button -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">Instructor Dashboard</h2>
        <p class="text-muted small mb-0">Manage faculty records, designations, and academic qualifications</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm px-4">
        + Add New Instructor
    </a>
</div>

<!-- Summary Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold small mb-1">Total Instructors</h6>
                <h2 class="fw-bold mb-0 text-primary">@totalInstructors</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold small mb-1">Active Majorships</h6>
                <h2 class="fw-bold mb-0 text-success">@uniqueMajorships</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm border-start border-info border-4 h-100">
            <div class="card-body">
                <h6 class="text-uppercase text-muted fw-semibold small mb-1">Faculty Designations</h6>
                <h2 class="fw-bold mb-0 text-info">@uniqueDesignations</h2>
            </div>
        </div>
    </div>
</div>

<!-- Main Table Card with Live Search -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
        <h5 class="mb-0 fw-semibold">Faculty Directory</h5>
        <div style="min-width: 260px;">
            <input type="text" id="searchInput" class="form-control form-control-sm" placeholder="Search by ID, name, or majorship..." />
        </div>
    </div>
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover align-middle mb-0" id="instructorTable">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-3">Instructor ID</th>
                    <th>Full Name</th>
                    <th>Designation</th>
                    <th>Majorship</th>
                    <th>Contact & Email</th>
                    <th class="text-center pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <p class="mb-2 fw-semibold">No instructor records found.</p>
                            <small>Click "+ Add New Instructor" at the top right to populate your directory.</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-primary">@item.InstructorID</td>
                            <td>
                                <div class="fw-semibold text-dark">@item.FullName</div>
                                <small class="text-muted">@item.Gender &bull; @item.Age yrs old</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-dark border px-2 py-1">
                                    @item.Designation
                                </span>
                            </td>
                            <td>@item.Majorship</td>
                            <td>
                                <div class="small">@item.EmailAddress</div>
                                <small class="text-muted">@item.ContactNumber</small>
                            </td>
                            <td class="text-center pe-3">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.InstructorID" class="btn btn-outline-info">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.InstructorID" class="btn btn-outline-warning">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.InstructorID" class="btn btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Instant Client-Side Search Script -->
@section Scripts {
    <script>document.getElementById('searchInput').addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#instructorTable tbody tr');

            rows.forEach(row => {
                // Skip the empty-state row if present
                if (row.cells.length === 1) return;

                let text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });</script>
}